# Client feature flags — enables fetch to /api/sathi (never put API keys here)
VITE_ENABLE_GEMINI=false
VITE_ENABLE_GROQ=true

# Server-only — loaded by Vite middleware / Node. NEVER prefix with VITE_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
GROQ_VISION_MODEL=qwen-3.6-27b

# Optional legacy provider fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
